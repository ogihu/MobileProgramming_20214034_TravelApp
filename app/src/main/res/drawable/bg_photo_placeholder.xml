<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/travel_sky_end"
                android:startColor="@color/travel_sky_start" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/ic_no_photo_travel" />
</layer-list>
