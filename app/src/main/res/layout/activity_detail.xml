<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/travel_surface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="96dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="286dp"
                android:background="@drawable/bg_polaroid_frame"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="34dp">

                <ImageView
                    android:id="@+id/imagePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_photo_rounded"
                    android:contentDescription="@string/detail_travel"
                    android:scaleType="centerCrop"
                    tools:src="@mipmap/ic_launcher" />

                <TextView
                    android:id="@+id/textDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/bg_stamp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="6dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/travel_primary"
                    tools:text="2026-05-20" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_notebook_page"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sage_chip"
                    android:text="@string/label_place"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/travel_primary" />

                <TextView
                    android:id="@+id/textPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/travel_ink"
                    android:textStyle="bold"
                    tools:text="제주도" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_sage_chip"
                    android:text="@string/label_location"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/travel_primary" />

                <TextView
                    android:id="@+id/textLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_map"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/travel_text_secondary"
                    tools:text="33.49, 126.53" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_stamp"
                    android:text="@string/label_memo"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/travel_primary" />

                <TextView
                    android:id="@+id/textMemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="6dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/travel_ink"
                    tools:text="한라산, 성산일출봉을 다녀온 날" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/context_edit"
        android:textColor="@color/white"
        android:visibility="gone"
        app:backgroundTint="@color/travel_primary"
        app:icon="@drawable/ic_edit"
        app:iconTint="@color/white"
        tools:visibility="visible" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
