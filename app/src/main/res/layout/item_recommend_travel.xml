<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="168dp"
    android:layout_height="210dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/travel_card_stroke"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageRecommend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/home_section_hot"
            android:scaleType="centerCrop"
            tools:src="@drawable/travel_recommend_1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_photo_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/textRecommendTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="신창 바다 코스" />

            <TextView
                android:id="@+id/textRecommendSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#EFFFFFFF"
                tools:text="노을과 바람이 예쁜 드라이브" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
