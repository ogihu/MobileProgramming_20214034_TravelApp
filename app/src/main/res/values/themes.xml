<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TravelApp_20214034_hero" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/travel_primary</item>
        <item name="colorPrimaryDark">@color/travel_primary_dark</item>
        <item name="colorSecondary">@color/travel_secondary</item>
        <item name="android:colorBackground">@color/travel_surface</item>
        <item name="android:statusBarColor">@color/travel_primary_dark</item>
    </style>

    <style name="Theme.TravelApp_20214034_hero" parent="Base.Theme.TravelApp_20214034_hero" />

    <style name="Theme.TravelApp_20214034_hero.WithActionBar" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/travel_primary</item>
        <item name="colorSecondary">@color/travel_secondary</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
        <item name="android:windowAnimationStyle">@style/TravelWindowAnimation</item>
    </style>

    <style name="TravelWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
